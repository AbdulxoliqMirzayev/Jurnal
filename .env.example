# =========================
# IRON TRADE MAJBURIY SOZLAMALAR
# =========================

# Telegram BotFather bergan token. Bot ishlashi uchun shuni to'ldirish shart.
BOT_TOKEN=

# OpenAI API kalit. Iron AI, JSON parsing, chart/screenshot va report AI xulosalari uchun kerak.
OPENAI_API_KEY=

# OpenAI model. Bitta model yozsangiz text va vision uchun shu model ishlaydi.
OPENAI_MODEL=gpt-5.5

# Vision uchun alohida model kerak bo'lsa yozing. OPENAI_MODEL bo'sh bo'lsa shu ishlatiladi.
OPENAI_VISION_MODEL=gpt-5.5


# =========================
# ADMIN
# =========================

# Bitta admin Telegram ID. Masalan: ADMIN_ID=1415503213
ADMIN_ID=

# Bir nechta admin ID bo'lsa vergul bilan yozing. Masalan: ADMIN_IDS=111,222,333
ADMIN_IDS=

# Admin username. Feedback tugmasi shu usernamega ochiladi.
ADMIN_USERNAME=mirzayev_ai


# =========================
# DATABASE
# =========================

# Bo'sh qoldirsangiz SQLite ishlaydi va bot faqat BOT_TOKEN + OPENAI_API_KEY bilan yuradi.
# 100k user uchun Railway PostgreSQL ulang:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=

# SQLite ishlatilganda fayl shu yerga yoziladi.
DB_PATH=data/iron_trade.db

# PostgreSQL ulanadigan katta trafikda connection pool. Boshlanishiga shunday qoldiring.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800

# Redis hozir optional. Keyinchalik katta trafikda rate limit/cache/FSM uchun ulanadi.
REDIS_URL=


# =========================
# BOT TILI VA VAQT
# =========================

# Default til: uz, en yoki ru.
DEFAULT_LANGUAGE=uz

# Eslatma va statistik sana hisoblash uchun timezone.
DEFAULT_TIMEZONE=Asia/Tashkent

# Kunlik jurnal eslatma default vaqti.
REMINDER_DEFAULT_TIME=22:00


# =========================
# RAILWAY / WEBHOOK
# =========================

# Bo'sh bo'lsa bot polling bilan ishlaydi. Boshlash uchun bo'sh qoldiring.
# Railway public domain olgandan keyin yozishingiz mumkin:
# WEBHOOK_URL=https://your-app.up.railway.app
WEBHOOK_URL=

# Telegram webhook endpoint.
WEBHOOK_PATH=/webhook

# Webhook xavfsizlik tokeni. Webhook ishlatmasangiz bo'sh qoldiring.
WEBHOOK_SECRET=

# Railway uchun 0.0.0.0 bo'lishi kerak.
WEB_SERVER_HOST=0.0.0.0

# Railway PORT ni avtomatik beradi. Lokal uchun 8080.
PORT=8080


# =========================
# STICKER / ANIMATION
# =========================

# Stickerlar yoqilsinmi. File ID bo'lmasa ham bot yiqilmaydi.
ENABLE_STICKERS=true

# Animation/GIFlar yoqilsinmi. File ID bo'lmasa ham bot text bilan ishlaydi.
ENABLE_ANIMATIONS=true

# Quyidagilar optional Telegram file_id. Hozircha bo'sh qoldirish mumkin.
WELCOME_STICKER_ID=
JOURNAL_STICKER_ID=
SUCCESS_STICKER_ID=
WARNING_STICKER_ID=
PROFIT_STICKER_ID=
LOSS_STICKER_ID=
RISK_STICKER_ID=
STATS_STICKER_ID=
EXPORT_STICKER_ID=
REMINDER_STICKER_ID=
EMOTION_STICKER_ID=
ADMIN_STICKER_ID=

WELCOME_ANIMATION_ID=
JOURNAL_ANIMATION_ID=
WRITING_ANIMATION_ID=
PROFIT_ANIMATION_ID=
LOSS_ANIMATION_ID=
STATS_ANIMATION_ID=
EXPORT_ANIMATION_ID=
REMINDER_ANIMATION_ID=


# =========================
# TEXNIK SOZLAMALAR
# =========================

# INFO production uchun yaxshi. DEBUG faqat xato qidirishda.
LOG_LEVEL=INFO

# Broadcast yuborganda har user orasida kutish. Telegram limitlardan himoya qiladi.
BROADCAST_DELAY_SECONDS=1
